// Devocional App — Schema
// La Biblia COMPLETA vive en esta base de datos.
// Convenciones: tablas y columnas en snake_case (español).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// LA BIBLIA
// ─────────────────────────────────────────────────────────────

model VersionBiblia {
  id         Int      @id @default(autoincrement())
  codigo     String   @unique @db.VarChar(20)
  nombre     String   @db.VarChar(120)
  idioma     String   @default("es") @db.VarChar(10)
  esDefault  Boolean  @default(false) @map("es_default")
  esPremium  Boolean  @default(false) @map("es_premium")
  activa     Boolean  @default(true)  // si false → no aparece a nadie (admin la apaga)
  esGlobal   Boolean  @default(true)  @map("es_global") // si false → solo usuarios con permiso explicito
  licencia   String?  @db.Text
  creadoEn   DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)

  versiculos     Versiculo[]
  usuariosPref   Usuario[]          @relation("UsuarioVersionPref")
  permisos       VersionUsuario[]

  @@map("versiones_biblia")
}

// N:M usuario↔version para versiones privadas (esGlobal=false).
// Si esGlobal=true se ignora esta tabla.
model VersionUsuario {
  versionId  Int      @map("version_id")
  usuarioId  String   @map("usuario_id") @db.Uuid
  creadoEn   DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)

  version  VersionBiblia @relation(fields: [versionId], references: [id], onDelete: Cascade)
  usuario  Usuario       @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@id([versionId, usuarioId])
  @@index([usuarioId])
  @@map("version_usuario")
}

model Libro {
  id            Int    @id @default(autoincrement())
  codigo        String @unique @db.VarChar(10)
  nombre        String @db.VarChar(60)
  nombreCorto   String @map("nombre_corto") @db.VarChar(20)
  testamento    String @db.VarChar(2) // 'AT' | 'NT' (CHECK en migración SQL)
  orden         Int    @unique @db.SmallInt
  numCapitulos  Int    @map("num_capitulos") @db.SmallInt

  versiculos Versiculo[]

  @@map("libros")
}

model Versiculo {
  id            BigInt @id @default(autoincrement())
  versionId     Int    @map("version_id")
  libroId       Int    @map("libro_id")
  capitulo      Int    @db.SmallInt
  versiculo     Int    @db.SmallInt
  texto         String @db.Text
  textoBusqueda Unsupported("tsvector")? @map("texto_busqueda")
  embedding     Unsupported("vector(384)")? // pgvector, llenado por seed-embeddings

  version       VersionBiblia       @relation(fields: [versionId], references: [id])
  libro         Libro               @relation(fields: [libroId], references: [id])
  estados       VersiculoEstado[]
  temas         VersiculoTema[]
  guardados     VersiculoGuardado[]
  rotaciones    RotacionUsuario[]
  entradasVersiculo     Entrada[] @relation("EntradaVersiculo")
  entradasLecturaInicio Entrada[] @relation("EntradaLecturaInicio")
  entradasLecturaFin    Entrada[] @relation("EntradaLecturaFin")

  @@unique([versionId, libroId, capitulo, versiculo])
  @@index([libroId, capitulo, versiculo], name: "idx_versiculos_ref")
  @@index([versionId], name: "idx_versiculos_version")
  // GIN sobre texto_busqueda se crea con SQL raw en la migración inicial.
  @@map("versiculos")
}

// ─────────────────────────────────────────────────────────────
// CLASIFICACIÓN (EL NÚCLEO DEL PRODUCTO)
// ─────────────────────────────────────────────────────────────

model EstadoAnimo {
  id            Int      @id @default(autoincrement())
  slug          String   @unique @db.VarChar(40)
  nombre        String   @db.VarChar(60)
  descripcion   String?  @db.Text
  emoji         String?  @db.VarChar(10)
  colorHex      String?  @map("color_hex") @db.VarChar(7)
  fraseAliento  String   @map("frase_aliento") @db.Text
  categoria     String   @db.VarChar(20) // 'dificil' | 'neutral' | 'positivo'
  orden         Int      @default(0) @db.SmallInt
  activo        Boolean  @default(true)

  versiculos    VersiculoEstado[]
  rotaciones    RotacionUsuario[]
  entradas      Entrada[]

  @@map("estados_animo")
}

model VersiculoEstado {
  id           BigInt   @id @default(autoincrement())
  versiculoId  BigInt   @map("versiculo_id")
  estadoId     Int      @map("estado_id")
  relevancia   Int      @default(5) @db.SmallInt // 1-10 (CHECK en SQL)
  intensidad   Int?     @db.SmallInt             // 1-3  (CHECK en SQL)
  notas        String?  @db.Text
  verificado   Boolean  @default(false)
  creadoEn     DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)

  versiculo Versiculo   @relation(fields: [versiculoId], references: [id], onDelete: Cascade)
  estado    EstadoAnimo @relation(fields: [estadoId], references: [id], onDelete: Cascade)

  @@unique([versiculoId, estadoId])
  @@index([estadoId, relevancia(sort: Desc)], name: "idx_ve_estado_relevancia")
  @@map("versiculo_estado")
}

model Tema {
  id     Int    @id @default(autoincrement())
  slug   String @unique @db.VarChar(40)
  nombre String @db.VarChar(60)

  versiculos VersiculoTema[]

  @@map("temas")
}

model VersiculoTema {
  versiculoId BigInt @map("versiculo_id")
  temaId      Int    @map("tema_id")

  versiculo Versiculo @relation(fields: [versiculoId], references: [id], onDelete: Cascade)
  tema      Tema      @relation(fields: [temaId], references: [id], onDelete: Cascade)

  @@id([versiculoId, temaId])
  @@map("versiculo_tema")
}

// ─────────────────────────────────────────────────────────────
// USUARIOS (anónimos y registrados)
// ─────────────────────────────────────────────────────────────

model Usuario {
  id                          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                       String?   @unique @db.VarChar(160)
  nombre                      String?   @db.VarChar(80)
  emailVerificado             Boolean   @default(false) @map("email_verificado")
  imagen                      String?   @db.Text
  versionPrefId               Int?      @map("version_pref_id")
  horaRecordatorio            DateTime? @map("hora_recordatorio") @db.Time(0)
  premiumHasta                DateTime? @map("premium_hasta") @db.Timestamptz(6)
  paymentProvider             String?   @map("payment_provider") @db.VarChar(20)
  stripeCustomerId            String?   @map("stripe_customer_id") @db.VarChar(120)
  stripeSubscriptionId        String?   @map("stripe_subscription_id") @db.VarChar(120)
  mercadopagoSubscriptionId   String?   @map("mercadopago_subscription_id") @db.VarChar(120)
  paypalSubscriptionId        String?   @map("paypal_subscription_id") @db.VarChar(120)
  rol                         String    @default("usuario") @db.VarChar(20) // 'usuario'|'pastor'|'admin'
  creadoEn                    DateTime  @default(now()) @map("creado_en") @db.Timestamptz(6)
  actualizadoEn               DateTime  @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz(6)
  ultimoAcceso                DateTime? @map("ultimo_acceso") @db.Timestamptz(6)

  versionPref   VersionBiblia?       @relation("UsuarioVersionPref", fields: [versionPrefId], references: [id])
  guardados    VersiculoGuardado[]
  rotaciones    RotacionUsuario[]
  entradas      Entrada[]
  suscripciones Suscripcion[]
  sesiones      Sesion[]
  cuentas       Cuenta[]
  versionesPermitidas VersionUsuario[]
  planesUsuario PlanUsuario[]
  peticiones    Peticion[]
  logros        LogroUsuario[]

  @@map("usuarios")
}

// ─── better-auth: sesiones, cuentas, verificaciones ───

model Sesion {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuarioId     String   @map("usuario_id") @db.Uuid
  token         String   @unique @db.VarChar(255)
  expiraEn      DateTime @map("expira_en") @db.Timestamptz(6)
  ip            String?  @db.VarChar(64)
  userAgent     String?  @map("user_agent") @db.Text
  creadoEn      DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)
  actualizadoEn DateTime @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz(6)

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("sesiones")
}

model Cuenta {
  id                       String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuarioId                String    @map("usuario_id") @db.Uuid
  accountId                String    @map("account_id") @db.VarChar(255)
  providerId               String    @map("provider_id") @db.VarChar(40)
  passwordHash             String?   @map("password_hash") @db.Text
  accessToken              String?   @map("access_token") @db.Text
  refreshToken             String?   @map("refresh_token") @db.Text
  idToken                  String?   @map("id_token") @db.Text
  accessTokenExpiraEn      DateTime? @map("access_token_expira_en") @db.Timestamptz(6)
  refreshTokenExpiraEn     DateTime? @map("refresh_token_expira_en") @db.Timestamptz(6)
  scope                    String?   @db.Text
  creadoEn                 DateTime  @default(now()) @map("creado_en") @db.Timestamptz(6)
  actualizadoEn            DateTime  @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz(6)

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([usuarioId])
  @@map("cuentas")
}

model Verificacion {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identifier    String   @db.VarChar(255)
  value         String   @db.Text
  expiraEn      DateTime @map("expira_en") @db.Timestamptz(6)
  creadoEn      DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)
  actualizadoEn DateTime @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz(6)

  @@index([identifier])
  @@map("verificaciones")
}

// ─────────────────────────────────────────────────────────────
// DIARIO ESPIRITUAL — entradas unificadas (modos: estado, lectura, conversacion)
// ─────────────────────────────────────────────────────────────
//
// Una `entrada` es una unidad atomica del diario del usuario.
// Free: 1 entrada/dia. Premium: ilimitadas. Limite enforced en app code.
//
// Modos:
//  - 'estado':       elige un estado de animo → recibe versiculo
//  - 'conversacion': elige estado + area (trabajo, pareja, ...) → recibe versiculo
//  - 'lectura':      lee un pasaje libre (rango de versiculos) y deja su nota
//
// Reglas (CHECK constraint en la migracion SQL):
//  - modo='estado'        → estado_id NOT NULL, versiculo_id NOT NULL
//  - modo='conversacion'  → estado_id NOT NULL, area NOT NULL, versiculo_id NOT NULL
//  - modo='lectura'       → lectura_inicio_id NOT NULL
model Entrada {
  id              BigInt   @id @default(autoincrement())
  usuarioId       String   @map("usuario_id") @db.Uuid
  fecha           DateTime @db.Date

  modo            String   @db.VarChar(20)

  estadoId        Int?     @map("estado_id")
  area            String?  @db.VarChar(20)
  versiculoId     BigInt?  @map("versiculo_id")

  lecturaInicioId BigInt?  @map("lectura_inicio_id")
  lecturaFinId    BigInt?  @map("lectura_fin_id")

  nota            String?  @db.Text

  creadoEn        DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)
  actualizadoEn   DateTime @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz(6)

  usuario       Usuario      @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  estado        EstadoAnimo? @relation(fields: [estadoId], references: [id])
  versiculo     Versiculo?   @relation("EntradaVersiculo", fields: [versiculoId], references: [id])
  lecturaInicio Versiculo?   @relation("EntradaLecturaInicio", fields: [lecturaInicioId], references: [id])
  lecturaFin    Versiculo?   @relation("EntradaLecturaFin", fields: [lecturaFinId], references: [id])

  @@index([usuarioId, fecha(sort: Desc)], name: "idx_entradas_usuario_fecha")
  @@index([usuarioId, creadoEn(sort: Desc)], name: "idx_entradas_usuario_creado")
  @@map("entradas")
}

// ─────────────────────────────────────────────────────────────
// PLANES DE LECTURA BÍBLICA
// ─────────────────────────────────────────────────────────────
//
// Un PlanLectura es un programa fijo de N días con pasajes asignados.
// PlanUsuario es la "suscripción" de un usuario a un plan (con fechaInicio).
// PlanUsuarioDia marca cuándo el usuario completó el día N del plan.

model PlanLectura {
  id          Int      @id @default(autoincrement())
  slug        String   @unique @db.VarChar(60)
  nombre      String   @db.VarChar(120)
  descripcion String?  @db.Text
  emoji       String?  @db.VarChar(10)
  dias        Int      @db.SmallInt
  categoria   String   @db.VarChar(40) // "completo"|"evangelios"|"salmos"|"estudio"|"corto"
  esDestacado Boolean  @default(false) @map("es_destacado")
  creadoEn    DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)

  diasContenido PlanLecturaDia[]
  suscripciones PlanUsuario[]

  @@map("planes_lectura")
}

model PlanLecturaDia {
  id      Int     @id @default(autoincrement())
  planId  Int     @map("plan_id")
  dia     Int     @db.SmallInt
  titulo  String? @db.VarChar(120)
  // Lista de pasajes: [{ libro: "GEN", capInicio: 1, capFin: 3, vInicio?, vFin? }]
  pasajes Json    @db.JsonB

  plan PlanLectura @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, dia])
  @@map("plan_lectura_dia")
}

model PlanUsuario {
  id           BigInt    @id @default(autoincrement())
  usuarioId    String    @map("usuario_id") @db.Uuid
  planId       Int       @map("plan_id")
  fechaInicio  DateTime  @map("fecha_inicio") @db.Date
  completadoEn DateTime? @map("completado_en") @db.Timestamptz(6)
  abandonadoEn DateTime? @map("abandonado_en") @db.Timestamptz(6)
  creadoEn     DateTime  @default(now()) @map("creado_en") @db.Timestamptz(6)

  usuario Usuario          @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  plan    PlanLectura      @relation(fields: [planId], references: [id])
  dias    PlanUsuarioDia[]

  @@index([usuarioId])
  @@map("plan_usuario")
}

model PlanUsuarioDia {
  id            BigInt   @id @default(autoincrement())
  planUsuarioId BigInt   @map("plan_usuario_id")
  dia           Int      @db.SmallInt
  leidoEn       DateTime @default(now()) @map("leido_en") @db.Timestamptz(6)
  notas         String?  @db.Text

  planUsuario PlanUsuario @relation(fields: [planUsuarioId], references: [id], onDelete: Cascade)

  @@unique([planUsuarioId, dia])
  @@index([planUsuarioId, dia])
  @@map("plan_usuario_dia")
}

// ─────────────────────────────────────────────────────────────
// LISTA DE ORACIONES / PETICIONES
// ─────────────────────────────────────────────────────────────
// Cada peticion del usuario. Estado: pendiente, respondida, archivada.
// Categorias: familia, salud, trabajo, finanzas, espiritual, otro.

model Peticion {
  id              BigInt    @id @default(autoincrement())
  usuarioId       String    @map("usuario_id") @db.Uuid
  titulo          String    @db.VarChar(160)
  descripcion     String?   @db.Text
  categoria       String    @default("otro") @db.VarChar(20)
  estado          String    @default("pendiente") @db.VarChar(20) // 'pendiente'|'respondida'|'archivada'
  respuesta       String?   @db.Text
  fechaPedida     DateTime  @default(now()) @map("fecha_pedida") @db.Timestamptz(6)
  fechaRespondida DateTime? @map("fecha_respondida") @db.Timestamptz(6)
  actualizadoEn   DateTime  @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz(6)

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, estado, fechaPedida(sort: Desc)])
  @@map("peticiones")
}

// ─────────────────────────────────────────────────────────────
// LOGROS (badges desbloqueados)
// ─────────────────────────────────────────────────────────────
// El catalogo vive hardcoded en lib/logros.ts. Aquí solo guardamos
// QUIÉN ganó QUÉ slug y cuándo.

model LogroUsuario {
  id        BigInt   @id @default(autoincrement())
  usuarioId String   @map("usuario_id") @db.Uuid
  slug      String   @db.VarChar(60)
  ganadoEn  DateTime @default(now()) @map("ganado_en") @db.Timestamptz(6)

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, slug])
  @@index([usuarioId])
  @@map("logro_usuario")
}

model VersiculoGuardado {
  id           BigInt   @id @default(autoincrement())
  usuarioId    String   @map("usuario_id") @db.Uuid
  versiculoId  BigInt   @map("versiculo_id")
  notaPersonal String?  @map("nota_personal") @db.Text
  // Subrayado: si tiene color es un highlight (subrayado en /leer).
  // Si es null, es un guardado clasico (heart desde PantallaVersiculo).
  color        String?  @db.VarChar(20)
  creadoEn     DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)

  usuario   Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  versiculo Versiculo @relation(fields: [versiculoId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, versiculoId])
  @@index([usuarioId, creadoEn(sort: Desc)], name: "idx_guardados_usuario")
  @@map("versiculos_guardados")
}

model RotacionUsuario {
  usuarioId    String   @map("usuario_id") @db.Uuid
  estadoId     Int      @map("estado_id")
  ultimoIndice Int      @default(0) @map("ultimo_indice")
  versiculoId  BigInt?  @map("versiculo_id")
  fecha        DateTime @db.Date

  usuario   Usuario     @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  estado    EstadoAnimo @relation(fields: [estadoId], references: [id], onDelete: Cascade)
  versiculo Versiculo?  @relation(fields: [versiculoId], references: [id])

  @@id([usuarioId, estadoId])
  @@index([usuarioId, fecha(sort: Desc)], name: "idx_rotacion_fecha")
  @@map("rotacion_usuario")
}

// ─────────────────────────────────────────────────────────────
// PAGOS
// ─────────────────────────────────────────────────────────────

model Suscripcion {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuarioId           String   @map("usuario_id") @db.Uuid
  provider            String   @db.VarChar(20) // 'stripe'|'mercadopago'|'paypal'
  externalId          String   @map("external_id") @db.VarChar(200)
  status              String   @db.VarChar(20) // 'active'|'canceled'|'past_due'
  plan                String   @db.VarChar(20) // 'premium_mensual'|'premium_anual'
  periodStart         DateTime @map("period_start") @db.Timestamptz(6)
  periodEnd           DateTime @map("period_end") @db.Timestamptz(6)
  cancelAtPeriodEnd   Boolean  @default(false) @map("cancel_at_period_end")
  creadoEn            DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([provider, externalId])
  @@index([usuarioId, periodEnd(sort: Desc)])
  @@map("suscripciones")
}
