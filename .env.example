# Copiar a .env y rellenar los valores.

# ─── Base de datos ───
DATABASE_URL="postgresql://devocional:devocional_local@localhost:5433/devocional?schema=public"

# ─── Auth (better-auth, open source) ───
# Generar con: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# ─── Stripe ───
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PREMIUM_MENSUAL=price_...
STRIPE_PRICE_PREMIUM_ANUAL=price_...

# ─── MercadoPago ───
MERCADOPAGO_ACCESS_TOKEN=APP_USR-...
MERCADOPAGO_CURRENCY=ARS
MERCADOPAGO_PRECIO_MENSUAL=4000
MERCADOPAGO_PRECIO_ANUAL=40000

# ─── PayPal ───
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_PLAN_PREMIUM_MENSUAL=P-...
PAYPAL_PLAN_PREMIUM_ANUAL=P-...

# ─── SMTP (servidor propio) ───
SMTP_HOST=smtp.tuservidor.com
SMTP_PORT=587
SMTP_USER=devo@tuservidor.com
SMTP_PASS=
SMTP_FROM="Devocional <devo@tuservidor.com>"

# ─── App ───
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Redis (opcional — cachea sesiones en better-auth) ───
# Sin esto la app funciona contra Postgres solamente.
REDIS_URL=redis://default:password@redis-host:6379

# ─── scripture.api.bible (American Bible Society) ───
# Gratis con sign-up en https://scripture.api.bible
# Permite acceso a NVI, RVR1960, RVC, LBLA, NBLA, DHH, etc.
# Sin esto la app solo muestra RV1909 (local). Algunas Biblias requieren
# aprobacion adicional desde el dashboard del usuario.
BIBLE_API_KEY=

# ─── Cron (recordatorios diarios) ───
# Generar con: openssl rand -base64 32
# Llamar con: curl -H "Authorization: Bearer $CRON_SECRET" $NEXT_PUBLIC_APP_URL/api/cron/recordatorios
CRON_SECRET=
